#!/bin/sh
set -u

export AWINO_PROJECT="${AWINO_PROJECT:-$PWD}"
PLUGIN_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v uv >/dev/null 2>&1; then
  echo "DEGRADED: A.W.I.N.O. agent and skills are active, but the deterministic ledger CLI needs uv and Python." >&2
  echo "Install uv, then run this command again. The locked CLI environment will be prepared automatically." >&2
  [ "${1:-}" = "hook" ] && exit 0
  exit 1
fi

export UV_LINK_MODE="${UV_LINK_MODE:-copy}"
unset VIRTUAL_ENV CONDA_PREFIX
exec uv run --frozen --no-dev --directory "$PLUGIN_ROOT" awino "$@"
